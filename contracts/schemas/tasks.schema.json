{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kyounoitte:schema:tasks:1",
  "title": "課題集（backend/public/data/tasks.json）",
  "description": "同梱の課題集。AC-3、AC-4、AC-29、AC-30。決まりは contracts/strings.md と contracts/budgets.md。件数、組ごとの件数、external の割合、ID の重複、平均の文字数は JSON Schema で書けないので受け入れテストで数える（contracts/test-hooks.md の W-6）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "tasks"
  ],
  "properties": {
    "formatVersion": {
      "const": 1,
      "description": "課題集の形式の版。形を変えたら上げる（アプリと一緒に配るので、古いアプリが新しい課題集を読むことはない）"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "area": {
      "enum": [
        "backend",
        "frontend",
        "database",
        "infra",
        "testing",
        "git"
      ],
      "description": "領域の ID。変えない（ADR 0002）"
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "段階の ID。変えない（ADR 0002）"
    },
    "taskId": {
      "type": "string",
      "pattern": "^(backend|frontend|database|infra|testing|git)-(beginner|intermediate|advanced)-[0-9]{3}$",
      "description": "<area>-<level>-<3 桁>。一度配った ID は消さず、使い回さず、別の課題に付け替えない（ADR 0002）"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "level",
        "mode",
        "minutes",
        "title",
        "why",
        "how",
        "goal",
        "tools"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "area": {
          "$ref": "#/$defs/area"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "mode": {
          "enum": [
            "in_app",
            "external"
          ],
          "description": "in_app＝画面の中で終わる。external＝外で行う（AC-29、AC-30）"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "description": "所要時間（分）。AC-3"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S",
          "not": {
            "type": "string",
            "pattern": "```"
          },
          "description": "題名。改行なし"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "not": {
            "type": "string",
            "pattern": "```"
          },
          "description": "なぜ今これか"
        },
        "how": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S",
          "not": {
            "type": "string",
            "pattern": "```"
          },
          "description": "やり方。段落は \\n で分ける。行内のコードはバッククォートで囲む。コードブロック（```）は使わない"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S",
          "not": {
            "type": "string",
            "pattern": "```"
          },
          "description": "完了の目安"
        },
        "tools": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "description": "要る道具。external は 1 件以上、in_app は 0 件"
        }
      },
      "allOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "not": {
                "type": "string",
                "pattern": "\\n"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "external"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "tools": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "tools": {
                "type": "array",
                "maxItems": 0
              },
              "title": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "https?://"
                }
              },
              "why": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "https?://"
                }
              },
              "how": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "https?://"
                }
              },
              "goal": {
                "type": "string",
                "not": {
                  "type": "string",
                  "pattern": "https?://"
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "backend"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^backend-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "frontend"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^frontend-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "database"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^database-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "infra"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^infra-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "testing"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^testing-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "area": {
                "const": "git"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^git-"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "level": {
                "const": "beginner"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "-beginner-[0-9]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "level": {
                "const": "intermediate"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "-intermediate-[0-9]{3}$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "level": {
                "const": "advanced"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "-advanced-[0-9]{3}$"
              }
            }
          }
        }
      ]
    }
  }
}