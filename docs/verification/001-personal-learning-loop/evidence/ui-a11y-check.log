    *, *::before, *::after {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Noto Sans JP", sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }
    [hidden] {
      display: none !important;
    }
    :focus-visible {
      outline: 3px solid var(--focus-ring);
      outline-offset: 2px;
    }
    .container {
      max-width: 72rem;
      margin: 0 auto;
      padding: 1.25rem 1rem 3rem;
    }
    .topbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1.25rem;
    }
    .brand-title {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .brand-sub {
      margin: 0.25rem 0 0;
      font-size: 0.9375rem;
      color: var(--text-secondary);
    }
    .topbar-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    button, input, select, textarea {
      font: inherit;
      color: inherit;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
      padding: 0.625rem 1.125rem;
      border-radius: 0.625rem;
      border: 1px solid transparent;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.12s ease, border-color 0.12s ease;
      text-align: center;
    }
    .btn-primary {
      background-color: var(--primary);
      color: var(--primary-contrast);
    }
    .btn-primary:hover:not(:disabled) {
      background-color: var(--primary-hover);
    }
    .btn-secondary {
      background-color: var(--surface-muted);
      color: var(--text);
      border-color: var(--border);
    }
    .btn-secondary:hover:not(:disabled) {
      border-color: var(--primary);
    }
    .btn-danger {
      background-color: var(--danger-text);
      color: #FFFFFF;
    }
    .btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .stats-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .stat-pill {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.875rem 1rem;
      box-shadow: var(--shadow);
    }
    .stat-label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .stat-value {
      font-size: 1.375rem;
      font-weight: 800;
      margin-top: 0.125rem;
    }
    .banner {
      border-radius: 0.75rem;
      padding: 0.875rem 1rem;
      margin-bottom: 1rem;
      border: 2px solid;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-weight: 600;
    }
    .banner-error {
      background-color: var(--danger-bg);
      border-color: var(--danger-border);
      color: var(--danger-text);
    }
    .banner-warning {
      background-color: var(--warning-bg);
      border-color: var(--warning-border);
      color: var(--warning-text);
    }
    .banner-success {
      background-color: var(--success-bg);
      border-color: var(--success-border);
      color: var(--success-text);
    }
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.25rem;
      margin-bottom: 1.25rem;
      box-shadow: var(--shadow);
    }
    .panel-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .panel-title {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 800;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.875rem;
      font-weight: 700;
      background-color: var(--accent-xp-bg);
      color: var(--accent-xp-text);
    }
    .empty-guide {
      text-align: left;
      background: var(--surface);
      border: 2px dashed var(--border);
      border-radius: 1rem;
      padding: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .empty-guide p {
      margin: 0 0 1rem;
      font-size: 1.0625rem;
      font-weight: 600;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      margin-bottom: 1rem;
    }
    .field label {
      font-weight: 700;
      font-size: 0.9375rem;
    }
    .input, .select, .textarea {
      width: 100%;
      min-height: 44px;
      padding: 0.625rem 0.75rem;
      border-radius: 0.625rem;
      border: 1px solid var(--border);
      background-color: var(--bg);
      color: var(--text);
    }
    .textarea {
      min-height: 7rem;
      resize: vertical;
    }
    .field-meta {
      display: flex;
      justify-content: flex-end;
      font-size: 0.8125rem;
      color: var(--text-secondary);
    }
    .subcard {
      background-color: var(--surface-muted);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem;
      margin-top: 0.875rem;
    }
    .rubric-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 0.75rem 0 1rem;
    }
    .rubric-check {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      min-height: 44px;
      padding: 0.5rem 0.75rem;
      border-radius: 0.625rem;
      background: var(--surface);
      border: 1px solid var(--border);
      cursor: pointer;
    }
    .rubric-check input[type="checkbox"] {
      min-width: 22px;
      min-height: 22px;
      margin-top: 0.2rem;
    }
    .grade-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
      gap: 0.625rem;
      margin-top: 0.75rem;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
      gap: 0.875rem;
    }
    .skill-card {
      background-color: var(--surface-muted);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem;
    }
    .skill-card-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .skill-name {
      font-weight: 800;
    }
    .skill-level {
      font-weight: 800;
      color: var(--primary);
    }
    .progress-track {
      width: 100%;
      height: 0.625rem;
      background-color: var(--surface);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border);
      margin-bottom: 0.5rem;
    }
    .progress-fill {
      height: 100%;
      background-color: var(--primary);
      border-radius: 999px;
      transition: width 0.2s ease;
    }
    .skill-foot {
      display: flex;
      justify-content: space-between;
      font-size: 0.8125rem;
      color: var(--text-secondary);
      font-weight: 600;
    }
    .model-points {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }
    .model-points li {
      margin-bottom: 0.375rem;
    }
  

